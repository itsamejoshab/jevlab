# jevlab configuration. Copy to .env and fill in at least one API key:
#
#   cp .env.example .env
#
# Everything below the keys is optional. Each commented line shows the built-in default; uncomment a line only to
# change it. Real environment variables win over .env. See docs/configuration.md for the longer story.

# =====================================================================================================================
# API keys
# =====================================================================================================================

# Required. Every LLM role below (generators, planner, proxy, embeddings) runs on OpenRouter, and OpenRouter can also
# serve the Jev oracle. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. A second backend for the Jev oracle, pooled with OpenRouter for more throughput.
# TYPESAFE_API_KEY=

# OPENROUTER_BASE=https://openrouter.ai/api/v1
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# =====================================================================================================================
# Site and data
# =====================================================================================================================

# The live Trick Jev site that `jevlab snapshot` reads and `jevlab publish` posts to.
# JEV_SITE=https://i-wanna-date-jev.begin-363.workers.dev

# Game edition: jev (data/), kev (data/kev/), laya (data/laya/), or clef (data/clef/). Kev, Laya, and Clef are
# mirror games with their own models and boards. Same as passing `--edition kev`, `--edition laya`, or
# `--edition clef` on the command line.
# JEV_EDITION=jev

# Signed-in session for snapshotting your own attempts and for publishing. Paste the Cookie header from your browser
# (at least __Secure-better-auth.session_token=...). Alternatively put the cookies in session.json.
# JEV_COOKIE=

# Where the SQLite database, vault, snapshots, and trained models live.
# JEVLAB_DATA=./data

# =====================================================================================================================
# Model: the Jev oracle (the classifier being optimized against)
# =====================================================================================================================
# This is the model the game itself uses to score phrases. jevlab calls it directly with the site's own request body
# so the search can run offline. Only change these if the site changes models.

# Jev: jev-latest. Kev: jaredpalmer/kev-4b (OpenRouter). Laya: convaiinnovations/laya (local Hugging Face).
# Clef: clef-flash (local Hugging Face repo Cloudflare/clef-flash). The site scores with 27B `clef`;
# estimates use the 9B flash checkpoint. Not the Workers AI API.
# JEV_MODEL=jev-latest

# Hugging Face repo downloaded by `jevlab install-laya`. Independent of the current edition.
# JEV_LAYA_REPO=convaiinnovations/laya

# Laya weights live here, outside the git repo. `uv sync --extra laya` then `jevlab install-laya`.
# JEV_LAYA_CACHE=~/.cache/jevlab/huggingface

# cpu, cuda, or mps. Empty lets PyTorch choose.
# JEV_LAYA_DEVICE=

# Hugging Face repo downloaded by `jevlab install-clef`. `Cloudflare/clef` is the 27B model the site uses.
# JEV_CLEF_REPO=Cloudflare/clef-flash

# Clef weights live here, outside the git repo. `uv sync --extra clef` then `jevlab install-clef`.
# JEV_CLEF_CACHE=~/.cache/jevlab/huggingface

# cpu, cuda, or mps. Empty uses CUDA when it exists.
# JEV_CLEF_DEVICE=

# auto, 4bit, offload, or none. auto: bf16 on a ~28GB GPU, 4-bit on a GPU with about 8GB, otherwise the
# checkpoint split across GPU, RAM, and disk.
# JEV_CLEF_QUANT=auto

# Model id that Jev's cached samples were recorded under, so a mirror run can look them up in Jev's database.
# JEV_SOURCE_MODEL=jev-latest

# Comma-separated backends: typesafe, openrouter, huggingface.
# Default: typesafe,openrouter on Jev, openrouter on Kev, huggingface on Laya and Clef.
# JEV_ORACLE_BACKENDS=typesafe,openrouter

# Concurrent oracle calls (AIMD adjusts between the start value and the max). Kev defaults: 4 and 8.
# Laya and Clef: 1 and 1.
# JEV_ORACLE_CONCURRENCY=24
# JEV_ORACLE_MAX_CONCURRENCY=48

# Seconds before a single remote oracle call is abandoned and retried. Kev default: 60.
# Laya and Clef do not use this.
# JEV_ORACLE_TIMEOUT=20

# =====================================================================================================================
# Model: generators (LLMs that write candidate phrases)
# =====================================================================================================================
# The generator pool is a table in jevlab/config.py (GEN_MODEL_TABLE), split into tiers that the bandit treats as
# arms: tier 0 "core" is always on, tier 1 "mid" joins at escalation level 2, tier 2 "premium" at level 4.
#
# JEV_GEN_MODELS replaces the whole table. Format: comma-separated id:tier:reasoning, where tier defaults to 0 and
# reasoning to "none" (OpenRouter reasoning effort: none, minimal, low, medium, high, or empty for provider default).
# JEV_GEN_MODELS=google/gemini-3.8-flash:0:minimal,deepseek/deepseek-v4-flash:0:none,moonshotai/kimi-k2.6:2:none

# Single-model jobs: rewrites and synonyms (default: first model in the table).
# JEV_GEN_MODEL=google/gemini-3.8-flash

# Fast, cheap model for high-volume single-word calls (beam next-words).
# JEV_GEN_MODEL_ALT=deepseek/deepseek-v4-flash

# Reasoning effort for models that are not in the table.
# JEV_GEN_REASONING=none

# OpenRouter provider routing within a model: latency, price, throughput, or empty for OpenRouter's default.
# JEV_PROVIDER_SORT=latency

# Per-call timeout for generator and planner requests, in seconds.
# JEV_LLM_TIMEOUT=60

# =====================================================================================================================
# Model: planner (a stronger model that proposes new framings when the search stalls)
# =====================================================================================================================

# JEV_PLAN_MODEL=google/gemini-3.1-pro-preview

# Planner calls allowed per question in the long-chain regime.
# JEV_LONG_PLAN_CALLS=2

# =====================================================================================================================
# Model: expensive generators (kept out of the long-chain round robin)
# =====================================================================================================================

# Comma-separated ids that are only called on a stall, at most JEV_GEMINI_CALLS times per question.
# JEV_EXPENSIVE_MODELS=google/gemini-3.8-flash
# JEV_GEMINI_CALLS=2

# =====================================================================================================================
# Model: proxy screen (a cheap stand-in for Jev at cold start)
# =====================================================================================================================
# Ranks candidates by yes/no logprobs before the per-question predictor has enough data to be trusted.
# Pick a new one with `jevlab bench-proxy`. Set to empty to turn the proxy screen off.

# JEV_PROXY_MODEL=qwen/qwen3-235b-a22b-2507

# =====================================================================================================================
# Model: embeddings (features for the phrase predictor)
# =====================================================================================================================
# "openrouter:<model id>" uses an OpenRouter embedding model (vectors are cached in SQLite).
# "local" uses fastembed bge-small on CPU and needs the extra: uv sync --extra embed
# Pick with `jevlab bench-embed`.

# JEV_EMBED_MODEL=openrouter:baai/bge-m3

# =====================================================================================================================
# Search tuning
# =====================================================================================================================

# Existing lines to score before generating (Kev, Laya, and Clef default: 40, Jev default: 0).
# Same as `search --transfer-k`.
# JEV_TRIAGE_K=0

# Word target for the experimental 300-word long-chain regime on Strict Highest. 0 turns it off.
# JEV_LONG_TARGET=0

# Plateau mode kicks in when the board leader holds the ceiling with a line at least this many words long.
# JEV_PLATEAU_LEADER_WORDS=40

# CPU threads for numpy / scikit-learn / ONNX (default: min(8, cores)).
# JEV_THREADS=8
